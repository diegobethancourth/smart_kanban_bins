{
  "uid": "smart-kanban",
  "title": "Smart Kanban Bins - UE-A",
  "tags": [
    "MFG 598",
    "IIoT"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "refresh": "5s",
  "schemaVersion": 39,
  "version": 1,
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "description": "Simulated smart Kanban bins at UE-A: stock per bin with the P-240 reorder point, reorder events and gateway status.",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Gateway gw01",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-smart-kanban"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-smart-kanban"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -30d)\n  |> filter(fn: (r) => r._measurement == \"gateway\" and r._field == \"online\")\n  |> last()\n  |> keep(columns: [\"_time\", \"_value\"])"
        }
      ],
      "description": "Birth / last-will message on css/UE-A/edge/gw01/status (T3.4).",
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "1": {
                  "text": "ONLINE",
                  "color": "#78BE20"
                },
                "0": {
                  "text": "OFFLINE",
                  "color": "#C8102E"
                }
              }
            }
          ],
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#C8102E",
                "value": null
              },
              {
                "color": "#78BE20",
                "value": 1
              }
            ]
          },
          "noValue": "no status yet"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Seconds since last data",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-smart-kanban"
      },
      "gridPos": {
        "x": 4,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-smart-kanban"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"level\" and r._field == \"units\")\n  |> last()\n  |> group()\n  |> max(column: \"_time\")\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: int(v: now()) - int(v: r._time)) / 1000000000.0}))"
        }
      ],
      "description": "Heartbeat check: each bin publishes at least every 60 s, so more than 90 s means the edge or the network is down.",
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#78BE20",
                "value": null
              },
              {
                "color": "#FFC627",
                "value": 60
              },
              {
                "color": "#C8102E",
                "value": 90
              }
            ]
          },
          "noValue": "no data"
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Bins flagged (fault or stuck)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-smart-kanban"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-smart-kanban"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: -1h)\n  |> filter(fn: (r) => r._measurement == \"level\" and r._field == \"status\")\n  |> last()\n  |> filter(fn: (r) => r._value != 0)\n  |> group()\n  |> count()"
        }
      ],
      "description": "status 1 = fault reported by the sensor, 2 = stuck sensor detected at the edge (T3.2). Flagged bins do not raise reorders.",
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "#78BE20",
                "value": null
              },
              {
                "color": "#C8102E",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "id": 4,
      "type": "table",
      "title": "Reorder events (P-240)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-smart-kanban"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-smart-kanban"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"reorder\" and (r._field == \"units\" or r._field == \"rop\" or r._field == \"ss\"))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> group()\n  |> keep(columns: [\"_time\", \"bin_id\", \"item\", \"units\", \"rop\", \"ss\"])\n  |> sort(columns: [\"_time\"], desc: true)"
        }
      ],
      "description": "One row per ROP crossing, from css/UE-A/bins/+/reorder.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto"
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "_time"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Time"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "bin_id"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Bin"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "item"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Item"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "units"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "Units"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "rop"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "ROP"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "ss"
            },
            "properties": [
              {
                "id": "displayName",
                "value": "SS"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "All bins: stock as a multiple of the ROP (1 = reorder point)",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-smart-kanban"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-smart-kanban"
          },
          "query": "from(bucket: v.defaultBucket)\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"level\" and (r._field == \"units\" or r._field == \"rop\"))\n  |> pivot(rowKey: [\"_time\"], columnKey: [\"_field\"], valueColumn: \"_value\")\n  |> map(fn: (r) => ({_time: r._time, _value: float(v: r.units) / r.rop, bin_id: r.bin_id}))\n  |> group(columns: [\"bin_id\"])"
        }
      ],
      "description": "First draft (T2.8): six stock lines on one chart, scaled by each ROP so they fit together.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "lineInterpolation": "stepAfter",
            "lineWidth": 1,
            "fillOpacity": 0,
            "showPoints": "never",
            "thresholdsStyle": {
              "mode": "line+area"
            }
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "transparent",
                "value": null
              },
              {
                "color": "#FFC627",
                "value": 1
              }
            ]
          },
          "displayName": "${__field.labels.bin_id}"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
