# Fully local fallback: no internet, no cloud accounts.
# Copy to .env.local, then run:
#   docker compose --profile local --env-file .env.local up --build
# (set ENV_FILE=.env.local too, so every service reads this file)
ENV_FILE=.env.local

MQTT_URL=mqtt://mosquitto:1883
MQTT_USER=edge
MQTT_PASS=local

INFLUX_URL=http://influxdb:8086
INFLUX_ORG=asu
INFLUX_BUCKET=smart_kanban
INFLUX_TOKEN=local-only-token-change-me
INFLUX_LOCAL_PASSWORD=local-only-password

SIM_SECONDS_PER_DAY=10
SIM_START_DAY=0
SIM_LOOP=1
SIM_FAULTS=

GRAFANA_ADMIN_PASSWORD=admin
