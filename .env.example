# Copy to .env and fill in. Never commit .env.
# Values come from the EMQX Cloud and InfluxDB Cloud consoles (T0.2).

# MQTT broker (EMQX Cloud Serverless). TLS on 8883; fallback wss://<host>:8084/mqtt (see docs/decisions.md)
MQTT_URL=mqtts://<your-deployment>.emqxsl.com:8883
MQTT_USER=
MQTT_PASS=
# Optional second broker user for the ingest service (defaults to MQTT_USER / MQTT_PASS)
INGEST_MQTT_USER=
INGEST_MQTT_PASS=

# InfluxDB Cloud
INFLUX_URL=https://<region>.cloud2.influxdata.com
INFLUX_ORG=
INFLUX_BUCKET=smart_kanban
INFLUX_TOKEN=

# Simulator
SIM_SECONDS_PER_DAY=10
SIM_START_DAY=0
SIM_LOOP=1
# Faults for the demo, e.g. bin03.stuck_from_day=30,bin04.hard_fault_from_day=50
SIM_FAULTS=

# Grafana admin password (viewers need no login)
GRAFANA_ADMIN_PASSWORD=
